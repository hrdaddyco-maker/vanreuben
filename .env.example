# Copy to .env locally. Never commit real values.
# Live Stripe secret only (sk_live_... or rk_live_...). Test-mode keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. If unset, Checkout uses price_data at $420 USD.
STRIPE_PRICE_ID=

DATABASE_URL=
# Optional direct (non-pooler) URL for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Optional. Order confirmation email after a paid Checkout session.
RESEND_API_KEY=
RESEND_FROM=

# Public site URL, no trailing slash. Used for Stripe success/cancel URLs.
PUBLIC_BASE_URL=https://vanreuben-shop.onrender.com

PORT=10000

# Internal fulfillment email recipient (defaults to the office inbox).
FULFILLMENT_EMAIL=gillesolivieroffice@gmail.com

# Shared secret for GET /admin/orders?token=... Do not commit the value.
ADMIN_TOKEN=
